# Copy to .env (gitignored) and fill in what you have. Everything is optional:
# with nothing configured EyeSee runs in offline demo mode.

# --- Google Cloud / Vertex AI (Gemini): speech → transcript + translation, AI, images
# Path to the service-account JSON key (keep it in ./secrets/, which is gitignored)
GOOGLE_APPLICATION_CREDENTIALS=./secrets/gcp-service-account.json
# …or paste the whole JSON into one variable instead:
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# --- JEV (TypeSafe AI System One): the 0–10 shared-understanding score
JEV_API_KEY=
# JEV_API_URL=https://api.typesafe.ai/v1/systemone
# JEV_MODEL=jev-latest

# --- Claude (optional): if set, Claude does translation / consent / EyeSee AI (Gemini still does speech)
# ANTHROPIC_API_KEY=
# EYESEE_MODEL=claude-opus-5

# --- OpenAI (optional alternative for speech-to-text / images)
# OPENAI_API_KEY=

# --- App
# PORT=8080
# HTTPS_PORT=8443
# EYESEE_PATIENT_LANG=ja
# EYESEE_CONSENT_THRESHOLD=8
# EYESEE_JUDGE=auto            # auto | jev | llm | heuristic
# EYESEE_MAX_IMAGES=12         # per visit
# EYESEE_MAX_CALLS_PER_MIN=60  # global guard on paid AI calls
